APP_NAME="Construye Fichaje"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5174

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_BUSINESS_TIMEZONE=Europe/Madrid

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Docker (docker-compose.yml): mysql. Without Docker: DB_CONNECTION=sqlite.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=fichaje
DB_USERNAME=fichaje
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=1440
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost:5174,localhost:8000,localhost:8080

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hola@example.es"
MAIL_FROM_NAME="${APP_NAME}"

# Stripe Checkout (card, EUR). Both are needed: the key opens the session,
# the webhook secret settles the order.
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Local demo only: pay with a button when Stripe is not set up. Never in
# production (ignored there).
PAYMENTS_SIMULATE=true

# Prices in cents, IVA included (config/catalog.php). Leave unset for the
# defaults written there.
# PRICE_OFFER_ACTIVE=3900
# PRICE_OFFER_PREMIUM=6900
# PRICE_CONTACTS_10=4900
# PRICE_EMPLOYER_PASS=14900
# PRICE_LEADS_5=3500
# PRICE_LEADS_15=8900
# PRICE_LEADS_40=19900
# OBRAS_MAX_UNLOCKS=4
